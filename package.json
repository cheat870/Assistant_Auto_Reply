{
  "name": "telegram-security-bot",
  "version": "1.0.0",
  "description": "Telegram Auto Reply + File Security Analysis + Manual Admin Review Bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && node scripts/db-sync.js && tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@grammyjs/runner": "^2.0.3",
    "@prisma/client": "^6.4.1",
    "@types/node": "^22.13.5",
    "@types/tar-stream": "^3.1.3",
    "@types/yauzl": "^3.1.3",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0",
    "prisma": "^6.4.1",
    "tar-stream": "^3.1.7",
    "typescript": "^5.7.3",
    "yauzl": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "vitest": "^3.0.6"
  }
}
